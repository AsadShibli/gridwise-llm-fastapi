# Copy to web/.env. Never commit a filled .env.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (docker-compose default). Leave empty to use local SQLite.
DATABASE_URL=postgresql://gridwise:gridwise@127.0.0.1:5432/gridwise

# Existing FastAPI service — Django posts /optimize-energy here.
FASTAPI_URL=http://127.0.0.1:8000
