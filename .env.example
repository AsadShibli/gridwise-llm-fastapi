# Copy to .env and fill in keys. Never commit a populated .env.

# Optional: running Free-AI Gateway (http://localhost:3000/v1).
FREE_AI_GATEWAY_URL=
FREE_AI_GATEWAY_API_KEY=not-needed

# Easiest path: free Groq key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

LLM_PROVIDER_PRIMARY=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_PROVIDER_FALLBACK=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=12
PORT=8000
